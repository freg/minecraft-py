    {"titre": "bob mine la pierre", "client": "bob", "envoie": {"type": "MINING_ATTEMPT", "payload": {"x": 5, "y": 70, "z": 5}}, "attend": {"type": "BLOCK_UPDATE", "payload": {"x": 5, "y": 70, "z": 5, "new_block_id": "AIR"}}},
    {"titre": "alice voit le minage", "client": "alice", "attend": {"type": "BLOCK_UPDATE", "payload": {"new_block_id": "AIR"}}, "delai_s": 1},
    {"titre": "triche : bob pose hors du monde (y=999)", "client": "bob", "envoie": {"type": "PLACE_ATTEMPT", "payload": {"x": 0, "y": 999, "z": 0, "block_id": "STONE"}}, "interdit": {"type": "BLOCK_UPDATE", "payload": {"y": 999}}, "pause_s": 0.6},
    {"titre": "triche : bloc inconnu « LAVE »", "client": "bob", "envoie": {"type": "PLACE_ATTEMPT", "payload": {"x": 6, "y": 70, "z": 6, "block_id": "LAVE"}}, "interdit": {"type": "BLOCK_UPDATE", "payload": {"new_block_id": "LAVE"}}, "pause_s": 0.6}
